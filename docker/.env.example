# Скопируйте в .env рядом с compose.yml (docker compose читает его
# автоматически) и поправьте значения.
#
# Точная версия, не latest: тег должен совпадать с бинарём в образе.
CSQTT_IMAGE=ghcr.io/w3struk/csqtt:2.5.3

# Публичный домен панели, например vpn.example.org. Пусто — автоопределение
# публичного IPv4 при первом старте. Читается только пока создаётся csqtt.env;
# дальше источник правды — том csqtt-data.
# CSQTT_HOST=vpn.example.org
